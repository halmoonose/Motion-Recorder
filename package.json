{
  "name": "hal-motion-recorder",
  "version": "1.0.0-rc.7",
  "description": "HAL3LAB Motion Recorder RC7 - Cubism 5 Live2D + 3D arms + webcam tracking + BGM",
  "main": "src/main.cjs",
  "type": "module",
  "scripts": {
    "start": "npm run build:engines && electron .",
    "dev": "npm run build:engines && electron .",
    "build:engines": "node scripts/build-engines.cjs",
    "build:win": "npm run build:engines && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.185.1",
    "live2d-renderer": "0.6.6"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9"
  },
  "build": {
    "appId": "jp.hal3lab.motionrecorder",
    "productName": "HAL Motion Recorder",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "models/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "models",
        "to": "models"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HAL-Motion-Recorder-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HAL Motion Recorder",
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "HAL3LAB"
}